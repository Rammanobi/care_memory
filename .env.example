# CareMemory environment. Copy to .env (git-ignored). NEVER put real keys here.
# On GCP the secrets below come from Secret Manager (--set-secrets); non-secret values from infra/env/*.env.yaml.
# Empty value = unset. Names follow INTEGRATION_DECISIONS.md (highest authority).

# ---- runtime role / modes ----
CM_ENV=dev                       # dev | demo | prod
CM_ROLE=api                      # api | worker | job (picks what `python -m cm` starts)
CM_JOB=                          # nightly | sweeper | seed | eval | migrate (only when CM_ROLE=job)
CM_DATA_CLASS=mock               # mock | real. "real" makes the config refuse deepseek: models
CM_SIM=1                         # 1 = simulated clock and mock channels allowed
CM_OFFLINE=0                     # 1 = offline demo: local queue, cassette LLM, sim channels (needs only Postgres)
DEMO_REPLAY=0                    # alias: sets CM_OFFLINE=1 and CM_CASSETTE=replay
DEMO_MODE=0                      # 1 = enables /sim/escalation-offset, /sim/sweep-now, /auth/demo-switch and /demo page
CM_CASSETTE=off                  # off | record | replay (LLM cassette)
CASSETTE_NAME=seed42             # cassette file name under fixtures/cassettes
TZ=Asia/Kolkata                  # all schedules are IST
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json                  # json (Cloud Logging) | console (local)
PORT=8080                        # HTTP port inside the container
CM_ALLOWED_HOSTS=                # comma list of host NAMES (no scheme/port; *.example.com ok) the API accepts; empty = any. /healthz is exempt
CM_COOKIE_DOMAIN=                # optional, e.g. .example.com to share the session cookie across subdomains; empty = host-only
CM_WEB_DIR=                      # built web app dir; default web/dist (/app/web/dist in the image); absent = API only
CM_SHUTDOWN_GRACE_S=25           # seconds to drain in-flight requests after SIGTERM
COOKIE_SECURE=0                  # 1 = Secure cookie; always on when CM_ENV=prod
CORS_ORIGINS=http://localhost:5173   # comma list of allowed browser origins (not needed when web and API share one origin)

# ---- GCP ----
GCP_PROJECT=your-gcp-project-id  # e.g. caremem-hack
GCP_REGION=asia-south1           # Mumbai
GCS_DOCS_BUCKET=your-gcp-project-id-cm-docs   # one bucket: uploads/lab/, uploads/csv/, raw/, guidelines/

# ---- database (Postgres 16 + pgvector >= 0.7) ----
DB_CONNECT_MODE=tcp              # tcp (local) | socket (Cloud Run /cloudsql/...) | connector (Cloud SQL Python Connector)
CLOUD_SQL_INSTANCE=your-gcp-project-id:asia-south1:cm-pg   # project:region:instance (socket/connector modes)
DB_IP_TYPE=PUBLIC                # PUBLIC | PRIVATE (connector mode)
DB_HOST=localhost                # tcp mode host ("db" inside docker compose)
DB_PORT=5432                     # tcp mode port
DB_NAME=caremem                  # database name
DB_USER_APP=cm_app               # API/worker role: events, approvals, outbox, task_runs
DB_PASSWORD_APP=change-me        # local dev password; Secret Manager in cloud
DB_USER_ENGINE=cm_engine         # memory engine / nightly role
DB_PASSWORD_ENGINE=change-me
DB_USER_READER=cm_reader         # read-only, v_* views only (dashboard tools)
DB_PASSWORD_READER=change-me
DB_USER_ADMIN=cm_admin           # migrations and erasure (cm-jobs only)
DB_PASSWORD_ADMIN=change-me      # NEW secret: only cm-jobs may read it
DB_POOL_MIN=1                    # pool min size per process
DB_POOL_MAX=5                    # pool max size (api 5, worker 4, jobs 10, sweeper/migrate 2; total < max_connections 100)
DB_POOL_TIMEOUT_S=10             # wait for a pooled connection
RAG_VECTOR_TYPE=halfvec          # halfvec | vector (fallback if pgvector < 0.7)
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/caremem_test   # tests with the db marker
CM_TEST_DB=0                     # 1 = run db-marked tests

# ---- LLM: OpenAI and/or DeepSeek only, "provider:model" strings ----
OPENAI_API_KEY=your-openai-key-here        # needed for vision + embeddings; never commit a real key
DEEPSEEK_API_KEY=your-deepseek-key-here       # optional worker model; refused when CM_DATA_CLASS=real
ORCHESTRATOR_MODEL=openai:<flagship-model>    # orchestrator, narrator, investigator lead. Pick the real name from the provider dashboard
WORKER_MODEL=deepseek:deepseek-chat           # intake, drafter, curator, sub-agents (the old "Haiku" role)
VISION_MODEL=<provider>:<vision-model>        # openai:* or deepseek:* (deepseek refused when CM_DATA_CLASS=real, images refused too); empty = lab results via JSON/CSV only
EMBEDDING_MODEL=openai:text-embedding-3-small # OpenAI only, 1536 dims; empty = Postgres full-text fallback
JUDGE_MODEL=                     # optional faithfulness judge; prefer the provider the orchestrator does not use
FALLBACK_MODEL=                  # optional other-provider model used after 3 timeouts/5xx (never after spend-cap errors)
LLM_TIMEOUT_S=60                 # per-call timeout
LLM_MAX_RETRIES=2                # SDK retries (cm.core.retry adds its own policy)
LLM_RPS_ORCHESTRATOR=1           # per-process rate limiter, requests/second
LLM_RPS_WORKER=3
LLM_RPS_VISION=0.5
LLM_RPS_EMBEDDING=5
TASK_TOKEN_BUDGET=60000          # per-task token budget
DAILY_COST_CAP_USD=15            # sweeper pauses agent-runs above this
LLM_ZDR_CONFIRMED=0              # 1 only after a zero-data-retention agreement (required for CM_DATA_CLASS=real)

# ---- Cloud Tasks / async ----
TASKS_MODE=local                 # local (in-process queue) | cloud (Cloud Tasks)
TASKS_QUEUE_AGENT_RUNS=agent-runs   # 2/s, 4 concurrent, 6 attempts
TASKS_QUEUE_RESUMES=resumes         # same limits as agent-runs
TASKS_QUEUE_OUTBOUND=outbound       # 5/s, 10 concurrent
TASKS_INVOKER_SA=cm-tasks-invoker@your-gcp-project-id.iam.gserviceaccount.com   # OIDC identity on enqueued tasks
WORKER_URL=http://localhost:8081    # cm-worker base URL (also the OIDC audience in cloud)
PUBLIC_BASE_URL=                    # public cm-api URL (run.app) or the ngrok URL; used for webhooks and links

# ---- Pub/Sub / Gmail ----
GMAIL_PUBSUB_TOPIC=projects/your-gcp-project-id/topics/gmail-push   # Gmail watch publishes here
PUBSUB_PUSH_AUDIENCE=            # audience of the push OIDC token = <cm-api>/webhooks/gmail
PUBSUB_PUSH_SA_EMAIL=cm-pubsub-push@your-gcp-project-id.iam.gserviceaccount.com   # expected token issuer SA
GMAIL_OAUTH_CLIENT_JSON=         # OAuth desktop client JSON (Secret Manager in cloud)
GMAIL_REFRESH_TOKEN=             # minted once by infra/gmail_auth.py (valid ~7 days while the consent screen is in Testing)
GMAIL_MAILBOX=                   # the dedicated demo clinic inbox address
DOCTOR_EMAIL_ALLOWLIST=          # comma-separated doctor emails allowed to reply to digests
GOOGLE_CALENDAR_ID=primary       # calendar used for the family-screen visit event (P0)

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=              # from BotFather; use a SEPARATE dev bot locally (one webhook per bot)
TELEGRAM_WEBHOOK_SECRET=         # random 32 chars, sent back as X-Telegram-Bot-Api-Secret-Token
TELEGRAM_PER_CHAT_RPS=1          # outbound limit per chat
TELEGRAM_GLOBAL_RPS=20           # outbound global limit
INBOUND_PER_CHAT_PER_MIN=30      # inbound flood limit per chat

# ---- security ----
JWT_SIGNING_KEY=                 # HS256 secret, >= 48 random bytes base64 (not JWT_SECRET)
JWT_TTL_MIN=480                  # session lifetime in minutes
PII_MASTER_KEY=                  # 32 random bytes base64: wraps per-person DEKs of the PII vault
DEMO_USER_PASSWORDS=             # JSON map of seeded demo users to passwords (scrypt-hashed at seed time)
LOGIN_PER_IP_PER_MIN=10          # login rate limit per IP
LOGIN_PER_USER_PER_MIN=5         # login rate limit per username
SMALL_CELL_THRESHOLD=5           # STS/DTO aggregates suppress cells smaller than this

# ---- Web Push (P1 PWA only) ----
VAPID_PUBLIC_KEY=                # P1: needed only if F2 PWA push is built
VAPID_PRIVATE_KEY=               # P1: Secret Manager only

# ---- observability (LangSmith) ----
LANGSMITH_TRACING=false          # true to send traces (mock data only)
LANGSMITH_API_KEY=               # LangSmith key
LANGSMITH_PROJECT=caremem-dev    # project name (caremem-prod in cloud; 14-day retention)
LANGSMITH_ENDPOINT=              # blank = default endpoint

# ---- reliability ----
HEARTBEAT_S=20                   # task_runs heartbeat interval
STALE_HEARTBEAT_S=120            # sweeper re-enqueues rows older than this
MAX_JOB_ATTEMPTS=6               # task attempts before dead-letter
AMBER_TTL_H=48                   # Amber approvals expire (reminder 24 h, backup doctor 36 h)
RED_ESCALATE_H=4                 # Red approvals escalate to the STS after this
OUTBOX_STUCK_MIN=5               # outbox rows pending longer than this are re-driven
OUTBOX_MAX_ATTEMPTS=3            # outbox send attempts
DRAIN_BATCH=20                   # outbox drainer batch size
SPEND_CAP_PAUSE_THRESHOLD=3      # spend-cap errors before the agent-runs queue is paused

# ---- simulation / evaluation ----
SIM_SEED=42                      # demo seed
SIM_PATIENTS=40                  # demo cohort size
SIM_DAYS=60                      # days of history
SIM_HORIZON_DAYS=14              # forward horizon for labels
SIM_START_DAY=59                 # day the demo snapshot is frozen at
DAY0_DATE=2026-08-27             # calendar date of sim day 0
SIM_OUT_DIR=./out/sim            # generator output
TRUTH_DIR=./out/truth            # ground truth (never importable from runtime code)
SNAPSHOT_PATH=fixtures/snapshots/seed42_d59.dump   # pg_dump used by make restore
SIM_PLAY_INTERVAL_MS=400         # console play loop, fast mode
EVAL_PATIENTS=200                # patients per live eval seed
EVAL_DAYS=3,7,14,28,42,60        # evaluation checkpoints
TRAIN_SEEDS=1000-1099            # risk model training seeds
CALIB_SEEDS=1100-1149            # calibration seeds
EVAL_SEED_MIN=2000               # judge seeds below this return 422 (except 42)
PRECOMPUTED_EVAL_SEEDS=2042,2077,2026   # cached eval reports
EVAL_BOOTSTRAP_LIVE=200          # bootstrap resamples for live eval
EVAL_BOOTSTRAP_FULL=1000         # bootstrap resamples for the full eval job
EVAL_LIVE_TIMEOUT_S=45           # /eval returns 202 after this
JUDGE_SAMPLE=30                  # narrator outputs scored by the judge

# ---- local dev only ----
NGROK_AUTHTOKEN=                 # ngrok account token for webhook tunnels

# DEMO_USER_PASSWORDS users: dr.rao, admin.demo, ravi.pt0142, lakshmi.s01 (test passwords are generated by `python -m cm.jobs.seed` into your git-ignored .env; placeholder only: <generated-in-.env>)

# ---- backend slice 1 (names only; real values go in your git-ignored .env) ----
# DB_USER=postgres               # local compose superuser; cloud uses DB_USER_APP etc.
# DB_PASSWORD=                   # local compose password
# DB_PORT=5433                   # host port; compose maps ${DB_PORT:-5432}. Use 5433 if another Postgres owns 5432
# CORS_ORIGINS=http://localhost:5173   # comma separated; default is the Vite dev server
# COOKIE_SECURE=0                # 1 behind https
# DAILY_COST_CAP_USD=10          # usage panel cap (default 10)
# MONTHLY_BUDGET_USD=150         # usage panel budget (default 150)
# CM_TEST_DB_NAME=caremem_test   # database used by pytest (never the dev database)

# ---- AI budget governor (names + placeholders only; defaults live in cm/core/budget.py) ----
CM_BUDGET_DAILY_USD=5            # global daily cap, reserve included
CM_BUDGET_TASK_USD=0.25          # per task
CM_BUDGET_PATIENT_TOKENS=60000   # per patient per day
CM_BUDGET_RESERVE_USD=1.25       # demo reserve, locked until unlocked
CM_BUDGET_RESERVE_UNLOCKED=0
CM_BUDGET_EVENT_USD=25           # whole-event budget (hard stop)
CM_MAX_TOOL_CALLS=40
CM_MAX_SUBAGENT_DEPTH=2
CM_PRICE_TABLE_JSON=             # {"<model>": [usd_in_per_1k, usd_out_per_1k]}
# ---- Telegram integration ----
FASTPATH_MISSED_THRESHOLD=3      # missed days in 3 days that raise a Red draft
# ---- Telegram polling (laptop, no public URL) ----
TG_OFFSET_FILE=                  # optional; default out/tg_offset.json
DEMO_IGNORE_QUIET_HOURS=0        # 1 = ignore 21:00-07:00 IST quiet hours; honoured only when CM_ENV=dev

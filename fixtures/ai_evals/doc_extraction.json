{
  "_about": "Synthetic mock documents for cm/uploads (extract -> doctor review item -> approve/reject). kind: txt | pdf (one-line text layer) | blank_pdf | binary | other | image (fake vision reply). expect.fields are [name, value] pairs the doctor-side draft must contain (values compared case-insensitively). abstain = the system must not be confident: amber tier and (needs_vision, a reason, or every field below 0.6). pii = raw strings that must never appear in the review payload. All names, numbers and ids are fake.",
  "low_conf": 0.6,
  "docs": [
    {"id": "doc-lab-en-smear", "lang": "en", "kind": "txt", "filename": "lab.txt", "mime": "text/plain",
     "text": "District Lab - Sputum Smear Report\nDate: 2026-10-12\nSmear: Negative\nGrade: Scanty",
     "expect": {"doc_type": "lab_report", "fields": [["date", "2026-10-12"], ["smear", "Negative"], ["grade", "Scanty"]]}},
    {"id": "doc-lab-en-cbnaat", "lang": "en", "kind": "txt", "filename": "result.txt", "mime": "text/plain",

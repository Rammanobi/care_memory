# Web env (names only). Real backend: VITE_USE_MOCK=false
VITE_USE_MOCK=true
VITE_API_BASE=http://localhost:8080
# Auth: "local" (default, /auth/login + cookie) or "firebase" (Firebase Auth SDK, bearer ID token).
VITE_AUTH_MODE=local
# Firebase only (public web config from the Firebase console; still keep values out of git/chat).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_AUTH_EMAIL_DOMAIN=users.carememory.app
# session (default, tab-scoped) or local
VITE_FIREBASE_PERSISTENCE=session
